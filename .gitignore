# Build outputs (racine du dépôt seulement : les dossiers build/ des sources du moteur,
# ex. engine/RogueEssence/NLua/build/*.csproj, font partie des sources et doivent être versionnés)
/build/
/dist/
engine/publish/
**/bin/
**/obj/
**/obj_core/

# Local tools and caches
.cache/
.pytest_cache/
__pycache__/
*.pyc

# Portable game data produced during testing
SAVE/
LOG/
LOGS/
REPLAY/
REPLAYS/
RESCUE/
RESCUE_IN/
RESCUE_OUT/
userdata/

# OS files
.DS_Store
Thumbs.db

# Carte town02 de 233 Mo : non versionnée telle quelle (limite GitHub, budget LFS du compte épuisé).
# Reconstituée depuis payload/WaterfallVillageCapital.rsground.gz par tools/unpack_payload.py
game/Data/Ground/WaterfallVillageCapital.rsground

# Index des planches : plus de 100 Mio, mais entièrement dérivé des en-têtes
# des fichiers .tile versionnés. Régénéré par tools/unpack_payload.py (qui
# appelle tools/build_tile_index.py) ; ne pas versionner en blob ordinaire.
game/Content/Tile/index.idx
