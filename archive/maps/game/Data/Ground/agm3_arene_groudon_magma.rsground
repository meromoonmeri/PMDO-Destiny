{"Version":"0.8.12.0","Object":{"$type":"RogueEssence.Ground.GroundMap, RogueEssence","TexSize":1,"Name":{"DefaultText":"Arene de Groudon V3 - colonnes de magma generees (4:3)","LocalTexts":{}},"Released":false,"Comment":"PMDO 0.8.12. Arene generee 4:3 (textures de la fosse de Dark Crater) ; magma visqueux, 4 colonnes de magma generees qui montent et sortent par le haut de la carte, symbole de Groudon grave a plat qui pulse sur le sol, braises. Arrivee au sud, boss sur le signe, heros au sud. Aucun warp.","rand":{"$type":"RogueElements.ReRandom, RogueElements","FirstSeed":0,"s":[16294208416658607535,7960286522194355700,487617019471545679,17909611376780542444]},"Status":{},"Background":{"$type":"RogueEssence.Dungeon.LayeredBG, RogueEssence","Layers":[]},"BlankBG":{"AutoTileset":"","Associates":[],"Layers":[],"NeighborCode":-1},"AssetName":"agm3_arene_groudon_magma","Music":"","EdgeView":1,"NoSwitching":false,"ViewCenter":null,"ViewOffset":{"X":0,"Y":0},"ActiveChar":null,"Decorations":[{"Name":"Vos decorations","Layer":2,"Visible":true,"Anims":[]}],"Entities":[{"Name":"Entrees et vos acteurs","Visible":true,"MapChars":[],"GroundObjects":[],"Spawners":[],"Markers":[{"EntName":"entrance","Direction":0,"EntEnabled":true,"triggerType":0,"Collider":{"X":384,"Y":560,"Width":16,"Height":16}},{"EntName":"boss","Direction":4,"EntEnabled":true,"triggerType":0,"Collider":{"X":376,"Y":264,"Width":16,"Height":16}},{"EntName":"heros","Direction":4,"EntEnabled":true,"triggerType":0,"Collider":{"X":376,"Y":400,"Width":16,"Height":16}}]}],"obstacles":[[{"Bounds":{"X":0,"Y":0,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":8,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":16,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":24,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":32,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":40,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":48,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":56,"Width":8,"Height":8},"Tag