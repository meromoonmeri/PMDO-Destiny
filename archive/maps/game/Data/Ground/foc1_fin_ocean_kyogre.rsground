{"Version":"0.8.12.0","Object":{"$type":"RogueEssence.Ground.GroundMap, RogueEssence","TexSize":1,"Name":{"DefaultText":"Fin Ocean - arene de Kyogre sous la mer (4:3)","LocalTexts":{}},"Released":false,"Comment":"PMDO 0.8.12. Fin de donjon generee 4:3 (ref. D42P41A, fond marin grave) ; sceau de Kyogre au centre, fosse abyssale au nord. Abysse en tourbillon, caustiques et nappes de lumiere, onde lumineuse sur toutes les gravures, algues qui ondulent, bulles, scintillements. Arrivee au sud, marqueur kyogre devant la fosse, marqueur sceau. Aucun warp.","rand":{"$type":"RogueElements.ReRandom, RogueElements","FirstSeed":0,"s":[16294208416658607535,7960286522194355700,487617019471545679,17909611376780542444]},"Status":{},"Background":{"$type":"RogueEssence.Dungeon.LayeredBG, RogueEssence","Layers":[]},"BlankBG":{"AutoTileset":"","Associates":[],"Layers":[],"NeighborCode":-1},"AssetName":"foc1_fin_ocean_kyogre","Music":"","EdgeView":1,"NoSwitching":false,"ViewCenter":null,"ViewOffset":{"X":0,"Y":0},"ActiveChar":null,"Decorations":[{"Name":"Vos decorations","Layer":2,"Visible":true,"Anims":[]}],"Entities":[{"Name":"Entrees et vos acteurs","Visible":true,"MapChars":[],"GroundObjects":[],"Spawners":[],"Markers":[{"EntName":"entrance","Direction":0,"EntEnabled":true,"triggerType":0,"Collider":{"X":384,"Y":560,"Width":16,"Height":16}},{"EntName":"kyogre","Direction":4,"EntEnabled":true,"triggerType":0,"Collider":{"X":368,"Y":200,"Width":16,"Height":16}},{"EntName":"sceau","Direction":0,"EntEnabled":true,"triggerType":0,"Collider":{"X":376,"Y":296,"Width":16,"Height":16}}]}],"obstacles":[[{"Bounds":{"X":0,"Y":0,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":8,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":16,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":24,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":32,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":40,"Width":8,"Height":8},"Tags":1},{"Bounds":{"X":0,"Y":48,"Width":8,"Height":8},"Tags":1},{"Boun