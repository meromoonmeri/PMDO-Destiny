index 0000000000000000000000000000000000000000..b5f6524d7536bc34fff23c62767c17e97a53c5f8
--- /dev/null
+++ b/game/Data/Script/destiny/rubans.lua
@@ -0,0 +1,22 @@
+-- Profils de pose seulement : jamais de filtre d'éligibilité supplémentaire.
+local pool = require 'destiny.starter_pool'
+local M = {}
+local epaule = {
+  rowlet=true, snom=true, beldum=true, joltik=true, applin=true, cosmog=true,
+  phanpy=true, larvesta=true, litwick=true, goomy=true, togepi=true,
+  fidough=true, budew=true, rookidee=true,
+}
+local col_bas = { tepig=true, squirtle=true }
+
+function M.installer()
+  -- Permet de passer du script seul à une build moteur complète sans
+  -- casser le lancement d'une ancienne édition portant les mêmes scripts.
+  local ok, moteur = pcall(luanet.import_type, 'RogueEssence.Content.DestinyRibbon')
+  if not ok or moteur == nil then return end
+  for _, s in ipairs(pool.construire(nil)) do
+    local coupe = epaule[s.espece] and 'epaule' or (col_bas[s.espece] and 'bas' or 'col')
+    moteur.RegisterStarter(s.espece, s.forme, coupe)
+  end
+end
+
+return M
diff --git a/game/Data/Script/destiny/starter_pool.lua b/game/Data/Script/destiny/starter_pool.lua
new file mode 100644
index 0000000000000000000000000000000000000000..c8867f80ed26ecc58ab87ed8e3f891d8cef3736c
--- /dev/null
+++ b/game/Data/Script/destiny/starter_pool.lua
@@ -0,0 +1,24 @@
+-- Liste commune au quiz de personnalité et au vestiaire.
+local source = require 'destiny.ground.personality_test.starters_source'
+local quiz = require 'destiny.ground.personality_test.quiz_data'
+local M = {}
+
+function M.construire(espece_exclue)
+  local pool, deja_vu = {}, {}
+  local function ajouter(s)
+    local key = s.espece .. ':' .. tostring(s.forme)
+    if s.espece ~= espece_exclue and not deja_vu[key] then
+      deja_vu[key] = true
+      table.insert(pool, s)
+    end
+  end
+  for _, s in ipairs(source.starters) do ajouter(s) end
+  for _, s in pairs(quiz.starters) do ajouter(s) end
+  table.sort(pool, function(a, b)
+    if a.gen ~= b.gen then return a.gen < b.gen end
+    return a.nom < b.nom
+  end)
+  return pool
+end
+
+return M
