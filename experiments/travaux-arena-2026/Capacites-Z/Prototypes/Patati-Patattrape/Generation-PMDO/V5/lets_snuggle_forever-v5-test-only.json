    "Name": {
      "DefaultText": "Let's Snuggle Forever",
      "LocalTexts": {
        "fr": "Patati-Patattrape",
        "de": "Herzliche Knuddelkloppe",
        "es": "Somanta Amistosa",
        "it": "Dolcesacco di Botte",
        "ko": "투닥투닥프렌드타임",
        "ja": "ぽかぼかフレンドタイム",
        "ja-jp": "ぽかぼかフレンドタイム",
        "zh-hans": "亲密无间大乱揍",
        "zh-hant": "親密無間大亂揍"
      }
    },
    "Desc": {
      "DefaultText": "After obtaining Z-Power, the user, Mimikyu, punches the target with full force.",
      "LocalTexts": {
        "fr": "Mimiqui concentre toute la Force Z dans son corps, et attaque dans le plus grand fracas !",
        "de": "Mimigma greift das Ziel mithilfe von Z-Kraft mit voller Wucht und viel Liebe an.",
        "es": "Mimikyu ataca con toda su fuerza tras imbuirse del Poder Z y asesta una lluvia de golpes.",
        "it": "Grazie al Potere Z, Mimikyu fa appello a tutte le sue forze e attacca il bersaglio tempestandolo di colpi.",
        "ko": "Z파워를 얻은 따라큐가 전력으로 투닥투닥 공격한다.",
        "ja": "Ｚパワーを　えた　ミミッキュが ぜんりょくで　ぽかぽか　こうげき。",
        "ja-jp": "Ｚパワーを　得た　ミミッキュが 全力で　ぽかぽか　攻撃。",
        "zh-hans": "得到Ｚ力量的谜拟Ｑ将全力进行乱揍攻击。",
        "zh-hant": "獲得Ｚ力量的謎擬Ｑ 將會以全力進行亂揍攻擊。"
      }
    },
